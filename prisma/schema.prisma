generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                String    @id @default(uuid())
  candidateName     String
  candidateEmail    String
  caseId            String
  caseTitle         String
  caseDomain        String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  durationSeconds   Int?
  finalOutput       String?
  postTestBlockA    Json?
  postTestBlockB    Json?
  postTestBlockC    Json?
  postTestBlockD    Json?
  postTestAvgA      Float?
  postTestAvgB      Float?
  postTestAvgC      Float?
  postTestAvgD      Float?
  logs              Log[]
  evaluation        Evaluation?
  tenantId String?                                                    // ← ADICIONAR
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])   // ← ADICIONAR
  invite   Invite? 

  @@index([candidateEmail])
  @@index([caseId])
  @@index([startedAt])
  @@index([tenantId]) 
}

model Log {
  id             Int      @id @default(autoincrement())
  sessionId      String
  sequenceNumber Int
  role           String
  content        String
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequenceNumber])
}

model Evaluation {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  d1Score         Float?
  d2Score         Float?
  d3Score         Float?
  d4Score         Float?
  haiqScore       Float?
  humanAgencyPct  Float?
  aiAgencyPct     Float?
  agencyClass     String?
  d1Parecer       String?
  d2Parecer       String?
  d3Parecer       String?
  d4Parecer       String?
  contextNote     String?
  hasGapD1        Boolean  @default(false)
  hasGapD2        Boolean  @default(false)
  hasGapD3        Boolean  @default(false)
  hasGapD4        Boolean  @default(false)
  gapLabels       String?
  gapsJson        Json?
  interviewQsJson Json?
  evidenceD1      Json?
  evidenceD2      Json?
  evidenceD3      Json?
  evidenceD4      Json?
  evidenceAgency  Json?
  evaluationPath  String?
  evaluatedAt     DateTime @default(now())
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum InviteStatus {
  PENDING
  STARTED
  COMPLETED
  CANCELED
}

model Tenant {
  id           String   @id @default(uuid())
  slug         String   @unique
  nome         String
  reportConfig Json?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  invites  Invite[]
  sessions Session[]

  @@index([slug])
}

model Invite {
  id       String       @id @default(uuid())
  tenantId String
  email    String
  nome     String?
  status   InviteStatus @default(PENDING)

  criadoEm     DateTime  @default(now())
  enviadoEm    DateTime?
  iniciadoEm   DateTime?
  concluidoEm  DateTime?
  canceladoEm  DateTime?
  canceladoPor String?

  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([email])
}
